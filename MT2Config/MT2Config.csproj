<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 is built into Windows 10 (1903+) / 11 and installable on Windows 7 SP1,
         so players get a single small config.exe with nothing else to install. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>config</AssemblyName>
    <RootNamespace>MT2Config</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- bin\Release\config.exe instead of bin\Release\net48\config.exe -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Version information shown in the file properties, matching the client's VERSIONINFO. -->
    <AssemblyTitle>MT2DevCore - Config</AssemblyTitle>
    <Company>MT2Dev Works (C)</Company>
    <Product>MT2DevCore</Product>
    <Description>Metin2 client configuration tool</Description>
    <Copyright>Copyright (C) 2026</Copyright>
    <Version>1.0.0.0</Version>
    <!-- Keep the product version "1.0.0.0" instead of "1.0.0.0+<commit hash>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="MainForm.cs" SubType="Form" />
    <EmbeddedResource Include="app.ico" LogicalName="MT2Config.app.ico" />
  </ItemGroup>

</Project>
